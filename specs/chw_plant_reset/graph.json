  "one.y -> tempMap.x2",
  "tempDesign.y -> tempMap.f2",
  "reset.y -> tempMap.u",
  "zero.y -> dpMap.x1",
  "dpLow.y -> dpMap.f1",
  "half.y -> dpMap.x2",
