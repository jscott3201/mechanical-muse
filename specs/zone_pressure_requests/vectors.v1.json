{
 "schema": "mechanical-muse/vectors/v1",
 "clock": {
  "step_s": 60.0,
  "horizon_s": 1080
 },
 "scenarios": [
  {
   "name": "damper_partly_open",
   "description": "Damper at 50 %, airflow at its setpoint: no requests.",
   "inputs": {
    "uDam": 0.5,
    "VDis_flow": 0.5,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 600.0,
     "equals": 0
    }
   ]
  },
  {
   "name": "damper_open_hysteresis",
   "description": "Airflow at its setpoint; the damper opens to 96 % at 120 s (1 request), eases to 90 % at 300 s (still 1: not yet at or below 85 %), drops to exactly 85 % at 480 s (0), returns to exactly 95 % at 600 s (still 0: not above 95 %), then 95.1 % at 720 s (1).",
   "inputs": {
    "uDam": [
     {
      "t": 0.0,
      "value": 0.5
     },
     {
      "t": 120.0,
      "value": 0.96
     },
     {
      "t": 300.0,
      "value": 0.9
     },
     {
      "t": 480.0,
      "value": 0.85
     },
     {
      "t": 600.0,
      "value": 0.95
     },
     {
      "t": 720.0,
      "value": 0.951
     }
    ],
    "VDis_flow": 0.5,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 60.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 420.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 480.0,
     "to_s": 660.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 720.0,
     "to_s": 900.0,
     "equals": 1
    }
   ]
  },
  {
   "name": "starved_three",
   "description": "Damper fully open from the start, airflow 0.2 of a 0.5 m3/s setpoint (below half): 1 request at once, 3 once the damper has been open 60 s.",
   "inputs": {
    "uDam": 1.0,
    "VDis_flow": 0.2,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 0.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 60.0,
     "to_s": 600.0,
     "equals": 3
    }
   ]
  },
  {
   "name": "starved_two",
   "description": "Damper fully open, airflow 0.3 of a 0.5 m3/s setpoint (below 70 % but not below half): 2 requests once the damper has been open 60 s.",
   "inputs": {
    "uDam": 1.0,
    "VDis_flow": 0.3,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 0.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 60.0,
     "to_s": 600.0,
     "equals": 2
    }
   ]
  },
  {
   "name": "airflow_recovers_through_the_bands",
   "description": "Damper open, setpoint 0.5 m3/s; airflow rises 0.2, 0.255 (still within 0.01 of half: 3), 0.27 (2), 0.355 (still within 0.01 of 70 %: 2), 0.37 (1), then falls back to 0.34 (2) and 0.24 (3).",
   "inputs": {
    "uDam": 1.0,
    "VDis_flow": [
     {
      "t": 0.0,
      "value": 0.2
     },
     {
      "t": 300.0,
      "value": 0.255
     },
     {
      "t": 420.0,
      "value": 0.27
     },
     {
      "t": 540.0,
      "value": 0.355
     },
     {
      "t": 660.0,
      "value": 0.37
     },
     {
      "t": 780.0,
      "value": 0.34
     },
     {
      "t": 900.0,
      "value": 0.24
     }
    ],
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 0.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 60.0,
     "to_s": 360.0,
     "equals": 3
    },
    {
     "output": "yPreReq",
     "from_s": 420.0,
     "to_s": 600.0,
     "equals": 2
    },
    {
     "output": "yPreReq",
     "from_s": 660.0,
     "to_s": 720.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 780.0,
     "to_s": 840.0,
     "equals": 2
    },
    {
     "output": "yPreReq",
     "from_s": 900.0,
     "to_s": 1080.0,
     "equals": 3
    }
   ]
  },
  {
   "name": "zone_not_served",
   "description": "Damper open and no airflow, but the setpoint is 0 (the zone is off): only the damper request. When the setpoint rises to 0.5 m3/s at 300 s the starved zone sends 3; at 0.008 m3/s from 600 s it is still served (not at or below 0.005), and at 0.004 m3/s from 780 s it is not.",
   "inputs": {
    "uDam": 1.0,
    "VDis_flow": 0.0,
    "VSet_flow": [
     {
      "t": 0.0,
      "value": 0.0
     },
     {
      "t": 300.0,
      "value": 0.5
     },
     {
      "t": 600.0,
      "value": 0.008
     },
     {
      "t": 780.0,
      "value": 0.004
     }
    ]
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 240.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 300.0,
     "to_s": 720.0,
     "equals": 3
    },
    {
     "output": "yPreReq",
     "from_s": 780.0,
     "to_s": 960.0,
     "equals": 1
    }
   ]
  },
  {
   "name": "reopen_restarts_the_timer",
   "description": "A starved zone whose damper is open from the start, closes to 80 % at 120 s and reopens at 300 s: 1 request at once, 3 from 60 s, 0 while closed, 1 at the reopen, and 3 again only after another 60 s.",
   "inputs": {
    "uDam": [
     {
      "t": 0.0,
      "value": 1.0
     },
     {
      "t": 120.0,
      "value": 0.8
     },
     {
      "t": 300.0,
      "value": 1.0
     }
    ],
    "VDis_flow": 0.1,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 0.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 60.0,
     "to_s": 60.0,
     "equals": 3
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 240.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 300.0,
     "to_s": 300.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 360.0,
     "to_s": 600.0,
     "equals": 3
    }
   ]
  }
 ]
}
