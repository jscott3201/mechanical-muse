{
 "schema": "mechanical-muse/vectors/v1",
 "clock": {
  "step_s": 60.0,
  "horizon_s": 1260
 },
 "scenarios": [
  {
   "name": "damper_partly_open",
   "description": "Damper at 50 %, airflow at its setpoint: no requests.",
   "inputs": {
    "uDam": 0.5,
    "VDis_flow": 0.5,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 600.0,
     "equals": 0
    }
   ]
  },
  {
   "name": "damper_open_hysteresis",
   "description": "Airflow at its setpoint; the damper opens to 96 % at 120 s (1 request), eases to 90 % at 300 s (still 1: not yet at or below 85 %), drops to exactly 85 % at 480 s (0), returns to exactly 95 % at 600 s (still 0: not above 95 %), then 95.1 % at 720 s (1).",
   "inputs": {
    "uDam": [
     {
      "t": 0.0,
      "value": 0.5
     },
     {
      "t": 120.0,
      "value": 0.96
     },
     {
      "t": 300.0,
      "value": 0.9
     },
     {
      "t": 480.0,
      "value": 0.85
     },
     {
      "t": 600.0,
      "value": 0.95
     },
     {
      "t": 720.0,
      "value": 0.951
     }
    ],
    "VDis_flow": 0.5,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 60.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 420.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 480.0,
     "to_s": 660.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 720.0,
     "to_s": 900.0,
     "equals": 1
    }
   ]
  },
  {
   "name": "starved_three",
   "description": "Damper at 60 % (not open), airflow 0.2 of a 0.5 m3/s setpoint (below half) from the start: nothing until the shortfall has lasted 120 s, then 3 requests.",
   "inputs": {
    "uDam": 0.6,
    "VDis_flow": 0.2,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 60.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 600.0,
     "equals": 3
    }
   ]
  },
  {
   "name": "starved_two",
   "description": "Airflow 0.3 of a 0.5 m3/s setpoint (below 70 %, not below half): 2 requests after 120 s.",
   "inputs": {
    "uDam": 0.6,
    "VDis_flow": 0.3,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 60.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 600.0,
     "equals": 2
    }
   ]
  },
  {
   "name": "short_one",
   "description": "Airflow 0.425 of a 0.5 m3/s setpoint (below 90 %, not below 70 %): 1 request after 120 s.",
   "inputs": {
    "uDam": 0.6,
    "VDis_flow": 0.425,
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 60.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 600.0,
     "equals": 1
    }
   ]
  },
  {
   "name": "airflow_recovers_through_the_bands",
   "description": "Setpoint 0.5 m3/s; airflow 0.2 (3 after 120 s), 0.255 at 300 s (still within 0.01 of half: 3), 0.27 (2), 0.355 (still within 0.01 of 70 %: 2), 0.37 (1), 0.455 (still within 0.01 of 90 %: 1), 0.47 (0); then back to 0.34 at 1020 s: the shortfalls start again, so 2 only from 1140 s.",
   "inputs": {
    "uDam": 0.6,
    "VDis_flow": [
     {
      "t": 0.0,
      "value": 0.2
     },
     {
      "t": 300.0,
      "value": 0.255
     },
     {
      "t": 420.0,
      "value": 0.27
     },
     {
      "t": 540.0,
      "value": 0.355
     },
     {
      "t": 660.0,
      "value": 0.37
     },
     {
      "t": 780.0,
      "value": 0.455
     },
     {
      "t": 900.0,
      "value": 0.47
     },
     {
      "t": 1020.0,
      "value": 0.34
     }
    ],
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 60.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 120.0,
     "to_s": 360.0,
     "equals": 3
    },
    {
     "output": "yPreReq",
     "from_s": 420.0,
     "to_s": 600.0,
     "equals": 2
    },
    {
     "output": "yPreReq",
     "from_s": 660.0,
     "to_s": 840.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 900.0,
     "to_s": 1080.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 1140.0,
     "to_s": 1260.0,
     "equals": 2
    }
   ]
  },
  {
   "name": "zone_not_served",
   "description": "Damper at 60 % and no airflow, but the setpoint is 0 (the zone is off): no requests. When the setpoint rises to 0.5 m3/s at 300 s the starved zone sends 3 from 420 s; at 0.008 m3/s from 600 s it is still served (not at or below 0.005), and at 0.004 m3/s from 780 s it is not.",
   "inputs": {
    "uDam": 0.6,
    "VDis_flow": 0.0,
    "VSet_flow": [
     {
      "t": 0.0,
      "value": 0.0
     },
     {
      "t": 300.0,
      "value": 0.5
     },
     {
      "t": 600.0,
      "value": 0.008
     },
     {
      "t": 780.0,
      "value": 0.004
     }
    ]
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 360.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 420.0,
     "to_s": 720.0,
     "equals": 3
    },
    {
     "output": "yPreReq",
     "from_s": 780.0,
     "to_s": 960.0,
     "equals": 0
    }
   ]
  },
  {
   "name": "brief_dips_ignored",
   "description": "Airflow at its setpoint except dips to 60 % for 60 s (300 s), 120 s (600 s) and 180 s (900 s): a dip counts only once it has lasted 120 s, so only the last one sends 2 requests, at 1020 s.",
   "inputs": {
    "uDam": 0.6,
    "VDis_flow": [
     {
      "t": 0.0,
      "value": 0.5
     },
     {
      "t": 300.0,
      "value": 0.3
     },
     {
      "t": 360.0,
      "value": 0.5
     },
     {
      "t": 600.0,
      "value": 0.3
     },
     {
      "t": 720.0,
      "value": 0.5
     },
     {
      "t": 900.0,
      "value": 0.3
     },
     {
      "t": 1080.0,
      "value": 0.5
     }
    ],
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 960.0,
     "equals": 0
    },
    {
     "output": "yPreReq",
     "from_s": 1020.0,
     "to_s": 1020.0,
     "equals": 2
    },
    {
     "output": "yPreReq",
     "from_s": 1080.0,
     "to_s": 1200.0,
     "equals": 0
    }
   ]
  },
  {
   "name": "damper_and_airflow",
   "description": "Damper at 96 % with airflow at 85 % of setpoint: 1 request at once from the damper, still 1 after 120 s; airflow falls to 60 % at 300 s, so 2 from 420 s.",
   "inputs": {
    "uDam": 0.96,
    "VDis_flow": [
     {
      "t": 0.0,
      "value": 0.425
     },
     {
      "t": 300.0,
      "value": 0.3
     }
    ],
    "VSet_flow": 0.5
   },
   "expect": [
    {
     "output": "yPreReq",
     "from_s": 0.0,
     "to_s": 360.0,
     "equals": 1
    },
    {
     "output": "yPreReq",
     "from_s": 420.0,
     "to_s": 600.0,
     "equals": 2
    }
   ]
  }
 ]
}
