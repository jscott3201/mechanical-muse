    {
     "output": "yChiWatResReq",
     "from_s": 720.0,
     "to_s": 1140.0,
     "equals": 3
    },
    {
     "output": "yChiWatResReq",
     "from_s": 1200.0,
     "to_s": 1500.0,
     "equals": 0
    },
    {
     "output": "yChiPlaReq",
     "from_s": 0.0,
     "to_s": 1500.0,
     "equals": 0
    }
   ]
  },
