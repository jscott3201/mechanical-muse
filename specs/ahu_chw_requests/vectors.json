   "name": "steady_normal",
   "description": "Supply air 0.5 K above setpoint, valve half open: no requests.",
   "inputs": {
    "TAirSup": 286.5,
    "TAirSupSet": 286.0,
    "uCooCoi": 0.5
   },
   "expect": [
    {
     "output": "yChiWatResReq",
     "from_s": 0.0,
     "to_s": 1200.0,
     "equals": 0
    },
    {
     "output": "yChiPlaReq",
     "from_s": 0.0,
     "to_s": 1200.0,
     "equals": 0
    }
   ]
  },
  {
   "name": "three_requests",
   "description": "Supply air 3.5 K above setpoint from 600 s: after 120 s the air handler sends 3 requests (the 2-request condition is also met, but 3 wins). When the error falls to 0.5 K at 1200 s the requests stop at once.",
